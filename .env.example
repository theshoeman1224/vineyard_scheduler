# Copy to .env for local dev. Production values live on the Cloudflare
# worker (`wrangler secret put`), never in a file — see README.

# --- Required -------------------------------------------------------------

# Postgres connection string. Production uses Neon's pooled (-pooler) URL;
# local dev can point at a Docker Postgres.
DATABASE_URL="postgres://user:password@host/dbname"

# Signs the email approve/deny links and the admin session cookie
# (any long random string, e.g. `openssl rand -base64 48`).
SIGNING_SECRET="change-me-to-a-long-random-string"

# Password for /admin.
ADMIN_PASSWORD="change-me"

# --- Optional (email) -----------------------------------------------------
# Leave RESEND_API_KEY empty to disable all email; the site works normally.

# Inbox that receives new-request notifications (with Approve/Deny links)
# and withdrawal notices. Empty = admin emails are skipped.
ADMIN_EMAIL="you@example.com"

# Verified Resend sender.
EMAIL_FROM="House Scheduler <onboarding@resend.dev>"

# Resend API key.
RESEND_API_KEY=""

# Public base URL used to build links in emails.
APP_URL="http://localhost:3000"
